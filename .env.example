# --- Server ---
PORT=4000
NODE_ENV=development

# ยังไม่มีผลตอนนี้ — src/app.js ตั้ง CORS เป็น origin: "*" ไว้
# ถ้าจะกลับมาจำกัดเฉพาะโดเมน ดูคอมเมนต์ใน src/app.js แล้วใส่ค่าที่นี่ (คั่นด้วย ,)
FRONTEND_ORIGIN=http://localhost:5173

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mine_rehab
DB_CONNECTION_LIMIT=10

# --- Auth ---
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Brute-force guard on POST /api/auth/login
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# --- ที่เก็บไฟล์รูป / PDF (Cloudinary) ---
# หาค่าได้ที่ Cloudinary Console > Dashboard (กด "API Keys")
# ใส่แบบ URL เส้นเดียวก็ได้ (แนะนำ):
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# หรือแยก 3 ตัว:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ขนาดไฟล์สูงสุดต่อครั้ง (MB) แยกตามชนิดไฟล์
#
# ข้อควรรู้: เพดานของบัญชีที่เก็บไฟล์เองก็จำกัดอีกชั้น และค่าที่ต่ำกว่าเป็นตัวตัดสิน
# Cloudinary แพ็กเกจฟรีรับได้ไม่เกิน 10 MB ต่อไฟล์ (ทดสอบแล้ว) — ถ้าตั้งเกินกว่านั้น
# ไฟล์จะผ่านเพดานของเว็บแต่ถูก Cloudinary ปฏิเสธ (ระบบจะแจ้งข้อความบอกว่าติดที่ไหน)
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_PDF_MB=50
